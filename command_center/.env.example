# Environment variables read by app.py. Set them in your shell or hosting
# dashboard (the app does not load a .env file automatically). Never commit real values.

# ---- Login -------------------------------------------------------------------
# LOCAL MODE needs none of this: with nothing set, log in as
#   operator / aegisai2026
#
# To use your own password, store only its HASH. Generate it (you'll be
# prompted; the password isn't echoed or saved in shell history):
#   python -c "import getpass; from werkzeug.security import generate_password_hash as h; print(h(getpass.getpass()))"
# The hash contains '$' characters, so wrap it in SINGLE quotes when setting it:
#   PowerShell:  $env:AEGISAI_PASSWORD_HASH = 'scrypt:32768:8:1$...'
#   bash:        export AEGISAI_PASSWORD_HASH='scrypt:32768:8:1$...'
AEGISAI_USERNAME=operator
AEGISAI_PASSWORD_HASH=
# Plaintext alternative - local mode only, ignored when a hash is set,
# refused in cloud mode.
# AEGISAI_PASSWORD=

# Flask session signing key (32+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AEGISAI_SECRET_KEY=

# ---- Deployment ----------------------------------------------------------------
# true on hosted servers with no camera: hides Live Vision, skips loading the
# vision models, sets Secure cookies, and REFUSES TO START unless
# AEGISAI_SECRET_KEY and AEGISAI_PASSWORD_HASH are properly set.
AEGISAI_CLOUD_MODE=false
# true when running behind a hosting proxy/load balancer, so login rate
# limiting uses the real client IP from X-Forwarded-For.
AEGISAI_TRUST_PROXY=false
# Extra origins allowed to open the live Socket.IO connection (comma-separated).
# Empty = same-origin only, which is right unless the UI is served elsewhere.
AEGISAI_ALLOWED_ORIGINS=

# ---- Command Chat (Claude) ---------------------------------------------------
# Optional. Enables the Claude decision agent in Command Chat; without it the
# coordinator falls back to keyword-based routing.
ANTHROPIC_API_KEY=
# Model id (default: claude-opus-5, Anthropic's current default model).
AEGISAI_CLAUDE_MODEL=claude-opus-5
# Answer depth vs latency/cost: low | medium | high | xhigh | max.
AEGISAI_CLAUDE_EFFORT=medium
# If the model declines a request, Anthropic re-runs it server-side on its
# recommended fallback model (beta server-side-fallback-2026-07-01).
AEGISAI_CLAUDE_FALLBACKS=true

# Live Vision tuning (local only).
# Minimum confidence for an object to get a tracked box in tracking mode.
# Drives ByteTrack's new_track_thresh / track_high_thresh (Ultralytics stock: 0.25).
AEGISAI_TRACK_CONF=0.25
# Detector input size: 320 = fastest, 640 = better on small/hard objects (~+35 ms/frame).
AEGISAI_INFER_SIZE=320
# COCO model used for tracking, e.g. yolov8n.pt (fast) or yolov8s.pt (more accurate).
AEGISAI_TRACK_MODEL=yolov8n.pt

# Which digital-twin zone the simulated sensor cluster and the Live Vision
# camera monitor. Their readings/detections raise risk and proposals there.
AEGISAI_SENSOR_ZONE=CorridorB
AEGISAI_CAMERA_ZONE=Room201
