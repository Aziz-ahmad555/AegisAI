# Environment variables read by app.py. Set them in your shell or hosting
# dashboard (the app does not load a .env file automatically). Never commit real values.

# Operator login. Change both before exposing the app beyond localhost.
AEGISAI_USERNAME=operator
AEGISAI_PASSWORD=change-me

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AEGISAI_SECRET_KEY=

# true on hosted servers with no camera: hides Live Vision and skips loading
# the vision models entirely.
AEGISAI_CLOUD_MODE=false

# Optional. Enables LLM-based agent routing in Command Chat; without it the
# coordinator falls back to keyword-based routing.
ANTHROPIC_API_KEY=
